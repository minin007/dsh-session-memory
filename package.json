{
  "name": "dsh-session-memory",
  "version": "0.4.0",
  "description": "Layered cross-session memory for DSH: core boot, generated index, on-demand search, negative memory, and a conversation view.",
  "type": "module",
  "license": "MIT",
  "author": "minin007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minin007/dsh-session-memory.git"
  },
  "homepage": "https://github.com/minin007/dsh-session-memory#readme",
  "bugs": {
    "url": "https://github.com/minin007/dsh-session-memory/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "agent",
    "context"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.mjs",
    "templates/*.md",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test-memory.mjs && node scripts/test-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  }
}
